<?xml version="1.0" encoding="utf-8"?>
<!-- activity_main.xml — Layout for the campus geo-fence tracker -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- ═══ App Title ═══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Office Campus Tracker"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pure WiFi RSSI Indoor and Campus Tracker"
            android:textSize="14sp"
            android:textColor="#757575"
            android:layout_marginBottom="24dp" />

        <!-- ═══ System Location Switch Warning Card ═══ -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_location_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFF3E0"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠️"
                        android:textSize="22sp"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="System Location Switch is OFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#E65100" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Android OS blocks Wi-Fi scanning when the system Location toggle in Quick Settings is OFF. Turn it ON to scan for campus Wi-Fi nodes. (No GPS is used)."
                    android:textSize="12sp"
                    android:textColor="#5D4037"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btn_enable_location"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="⚙️ Open Settings to Turn On Location"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#EF6C00" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ═══ Status Card ═══ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap Start to begin tracking"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#757575"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tv_current_zone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 Current Zone: --"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2"
                    android:layout_marginTop="8dp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tv_nearest_ap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nearest AP: --"
                    android:textSize="13sp"
                    android:textColor="#616161"
                    android:layout_marginTop="4dp"
                    android:gravity="center" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ═══ Toggle Button ═══ -->
        <Button
            android:id="@+id/btn_toggle_tracking"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="▶ Start Tracking"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#388E3C"
            android:layout_marginBottom="24dp" />

        <!-- ═══ Details Section (hidden until tracking starts) ═══ -->
        <LinearLayout
            android:id="@+id/layout_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Confidence Score -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_confidence"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Combined Confidence: --"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1565C0"
                        android:layout_marginBottom="8dp" />

                    <ProgressBar
                        android:id="@+id/progress_confidence"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="#1565C0" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- WiFi Score -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_wifi_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WiFi RSSI Confidence: --"
                        android:textSize="14sp"
                        android:textColor="#E65100"
                        android:layout_marginBottom="8dp" />

                    <ProgressBar
                        android:id="@+id/progress_wifi"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="#EF6C00" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Detail Info -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Details"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#37474F"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tv_mesh_aps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Visible mesh APs: --"
                        android:textSize="14sp"
                        android:textColor="#455A64"
                        android:layout_marginBottom="6dp"
                        android:drawableStart="@android:drawable/ic_menu_mapmode"
                        android:drawablePadding="8dp" />

                    <TextView
                        android:id="@+id/tv_avg_signal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Avg signal strength: --"
                        android:textSize="14sp"
                        android:textColor="#455A64"
                        android:drawableStart="@android:drawable/ic_menu_share"
                        android:drawablePadding="8dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Campus Floor Nodes Breakdown -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Campus Floor WiFi Nodes"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#0D47A1"
                        android:layout_marginBottom="12dp" />

                    <!-- Node 1: RECEPTION -->
                    <TextView
                        android:id="@+id/tv_node1_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Node 1: RECEPTION (OFFICE_RECEPTION)"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#212121" />

                    <TextView
                        android:id="@+id/tv_node1_signal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Signal: Not detected (58:BF:25:92:F3:41)"
                        android:textSize="12sp"
                        android:textColor="#757575"
                        android:layout_marginBottom="4dp" />

                    <ProgressBar
                        android:id="@+id/progress_node1"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="#1976D2"
                        android:layout_marginBottom="12dp" />

                    <!-- Node 2: FLOOR_1 -->
                    <TextView
                        android:id="@+id/tv_node2_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Node 2: FLOOR 1 (OFFICE_FLOOR1)"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#212121" />

                    <TextView
                        android:id="@+id/tv_node2_signal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Signal: Not detected (88:13:BF:09:D6:55)"
                        android:textSize="12sp"
                        android:textColor="#757575"
                        android:layout_marginBottom="4dp" />

                    <ProgressBar
                        android:id="@+id/progress_node2"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="#388E3C"
                        android:layout_marginBottom="12dp" />

                    <!-- Node 3: FLOOR_2 -->
                    <TextView
                        android:id="@+id/tv_node3_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Node 3: FLOOR 2 (OFFICE_FLOOR2)"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#212121" />

                    <TextView
                        android:id="@+id/tv_node3_signal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Signal: Not detected (8C:94:DF:6D:73:81)"
                        android:textSize="12sp"
                        android:textColor="#757575"
                        android:layout_marginBottom="4dp" />

                    <ProgressBar
                        android:id="@+id/progress_node3"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="#F57C00" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
