<?xml version="1.0" encoding="utf-8"?>
<!--
    AndroidManifest.xml — Permissions and service declarations for
    the Office Campus Geo-Fence Tracker.
    
    MERGE this into your actual project's AndroidManifest.xml.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.officegeotracker">

    <!-- ═══════════════════════════════════════════════════════════
         PERMISSIONS
         ═══════════════════════════════════════════════════════════ -->

    <!-- GPS / Location -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Required for Android 10+ to get location while in background -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- WiFi Scanning -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Required for Android 13+ to scan nearby WiFi -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />

    <!-- Foreground Service (Android 9+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Internet (for Google Play Services / FusedLocationProvider) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Office Campus Tracker"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.DarkActionBar">

        <!-- ═══ Main Activity ═══ -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Office Campus Tracker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ═══ Geo-Fence Tracking Foreground Service ═══ -->
        <service
            android:name=".GeoFenceTrackingService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

    </application>

</manifest>
